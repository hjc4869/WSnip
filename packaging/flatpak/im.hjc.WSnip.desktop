[Desktop Entry]
Type=Application
Name=WSnip
GenericName=Screenshot Tool
Comment=Capture, mark up and save screenshots
Exec=wsnip
Icon=im.hjc.WSnip
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;snip;capture;screen;
StartupNotify=true
SingleMainWindow=true
Actions=NewSnip;Rectangle;Window;Fullscreen;Freeform;WholeWindow;
X-KDE-Wayland-Interfaces=zkde_screencast_unstable_v1

[Desktop Action NewSnip]
Name=New snip
Exec=wsnip --snip

[Desktop Action Rectangle]
Name=Rectangle snip
Exec=wsnip --snip rectangle

[Desktop Action Window]
Name=Window snip
Exec=wsnip --snip window

[Desktop Action Fullscreen]
Name=Full screen snip
Exec=wsnip --snip fullscreen

[Desktop Action Freeform]
Name=Freeform snip
Exec=wsnip --snip freeform

[Desktop Action WholeWindow]
Name=Whole window snip
Exec=wsnip --snip wholewindow

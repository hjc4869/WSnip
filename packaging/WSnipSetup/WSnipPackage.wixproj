<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InstallerArchitecture Condition="'$(InstallerArchitecture)' == ''">x64</InstallerArchitecture>
    <InstallerPlatform>$(InstallerArchitecture)</InstallerPlatform>
    <PackageUpgradeCode>e710e5ca-94c3-4455-8dde-a92336780a5b</PackageUpgradeCode>
    <MsiVersion Condition="'$(MsiVersion)' == ''">0.1.0</MsiVersion>
    <PublishDirectory Condition="'$(PublishDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\windows-installer\$(InstallerArchitecture)\publish</PublishDirectory>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\windows-installer\$(InstallerArchitecture)\msi\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\obj\WSnipSetup\package\$(InstallerArchitecture)\</IntermediateOutputPath>
    <OutputName>WSnip-$(InstallerArchitecture)</OutputName>
    <DefaultCompressionLevel>high</DefaultCompressionLevel>
    <!-- ICE09 and ICE32 require optional VBScript; ICE61 flags deliberate same-version upgrades. -->
    <SuppressIces>$(SuppressIces);ICE09;ICE32;ICE61</SuppressIces>
    <DefineConstants>$(DefineConstants);MsiVersion=$(MsiVersion);PackageUpgradeCode=$(PackageUpgradeCode);PublishDirectory=$(PublishDirectory);IconPath=$(MSBuildThisFileDirectory)..\..\src\WSnip.App\Assets\wsnip.ico;LicensePath=$(MSBuildThisFileDirectory)..\..\LICENSE;ThirdPartyPath=$(MSBuildThisFileDirectory)..\..\THIRDPARTY.txt</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Package.wxs" />
  </ItemGroup>
</Project>

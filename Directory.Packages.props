<Project>
  <Import Project="$(LightPlayerRoot)Directory.Packages.props" />

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- Linux platform services (session bus, desktop portals and KWin's Wayland protocols). -->
  <ItemGroup>
    <!-- Must match the NWayland that Avalonia.Wayland binds to. -->
    <PackageVersion Include="NWayland" Version="0.12.5" />
    <PackageVersion Include="NWayland.Protocols.Plasma" Version="0.12.5" />
  </ItemGroup>
</Project>

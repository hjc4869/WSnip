<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:WSnip.App.Rendering">
    <!-- A bare Path reports a size including its origin offset; Uniform keeps glyphs centered. -->
    <Style Selector="Viewbox > Path">
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!--
        Glyphs inside buttons take the text color of the button's state. A glyph is part of the
        button's content, a logical child of the button rather than of its template, so it is
        styled through the button instead of binding to the template's presenter.
    -->
    <Style Selector="Button.icon Path, Button.flat Path, ToggleButton.tool Path">
        <Setter Property="Fill" Value="{DynamicResource AppPrimaryTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked Path">
        <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.accent Path">
        <Setter Property="Fill" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>

    <!-- Transparent icon-only button. -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSubtlePressedBrush}" />
    </Style>
    <Style Selector="Button.icon:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Text button without chrome for toolbars; shares the icon button's hover wash. -->
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flat /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSubtlePressedBrush}" />
    </Style>
    <Style Selector="Button.flat:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Primary call to action. -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Markup tools and snip modes: a toggle that shows its state with a selection fill. -->
    <Style Selector="ToggleButton.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.tool /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSubtleHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Color swatches of the pen palette; the content is a ColorSwatch, which shows HDR and wide colors. -->
    <Style Selector="RadioButton.swatch">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" Padding="3">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="rendering|ColorSwatch">
        <Setter Property="Stroke" Value="{DynamicResource AppDividerBrush}" />
    </Style>
    <Style Selector="RadioButton.swatch:checked /template/ Border#Ring">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="RadioButton.swatch:pointerover /template/ Border#Ring">
        <Setter Property="Background" Value="{DynamicResource AppSubtleHoverBrush}" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,8" />
        <Setter Property="Background" Value="{DynamicResource AppDividerBrush}" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,18,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
    </Style>

    <Style Selector="Border.settingRow">
        <Setter Property="Background" Value="{DynamicResource AppContentLayerBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="MinHeight" Value="56" />
    </Style>

    <!-- The floating toolbar of the capture overlay. -->
    <Style Selector="Border.overlayBar">
        <Setter Property="Background" Value="{DynamicResource AppFlyoutBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
    </Style>

    <!-- Details of the pixel under the pointer, floating next to it over the snip. -->
    <Style Selector="Border.pixelInfo">
        <Setter Property="Background" Value="{DynamicResource AppFlyoutBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BoxShadow" Value="0 4 12 0 #30000000" />
    </Style>
    <Style Selector="Border.pixelInfo TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
    </Style>
    <Style Selector="Border.pixelInfo TextBlock.caption">
        <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
    </Style>
</Styles>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:WSnip.App.Settings"
        xmlns:strings="using:WSnip.Core.Strings"
        x:Class="WSnip.App.Settings.SettingsWindow"
        Title="{x:Static strings:AppStrings.SettingsTitle}"
        Width="660" Height="760" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppShellBackgroundBrush}"
        Icon="avares://WSnip.App/Assets/wsnip.ico">
    <ScrollViewer>
        <StackPanel Margin="24,12,24,24">
            <TextBlock Text="{x:Static strings:AppStrings.Settings}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,4" Foreground="{DynamicResource AppPrimaryTextBrush}" />

            <TextBlock Classes="sectionTitle" Text="{x:Static strings:AppStrings.TakingSnips}" />
            <settings:HotkeyRow x:Name="DefaultHotkeyRow" Title="{x:Static strings:AppStrings.Shortcut}"
                                Caption="{x:Static strings:AppStrings.DefaultShortcutCaption}" />
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Static strings:AppStrings.SnippingMode}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ModeBox" Grid.Column="1" Width="150" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Static strings:AppStrings.Delay}" VerticalAlignment="Center" />
                    <ComboBox x:Name="DelayBox" Grid.Column="1" Width="150" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Static strings:AppStrings.IncludeCursor}" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="CursorSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
            </Border>

            <StackPanel x:Name="ModeHotkeySection">
                <TextBlock Classes="sectionTitle" Text="{x:Static strings:AppStrings.ModeShortcuts}" />
                <StackPanel x:Name="ModeHotkeyRows" />
            </StackPanel>

            <TextBlock Classes="sectionTitle" Text="{x:Static strings:AppStrings.AfterSnip}" />
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Static strings:AppStrings.CopyClipboard}" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="CopySwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Static strings:AppStrings.OpenEditor}" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="EditorSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static strings:AppStrings.ShowPixelInfo}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="{x:Static strings:AppStrings.PixelInfoCaption}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="PixelInfoSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static strings:AppStrings.AutoSave}" />
                        <TextBlock x:Name="FolderText" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="FolderButton" Classes="flat" Content="{x:Static strings:AppStrings.ChangeFolder}" />
                        <ToggleSwitch x:Name="AutoSaveSwitch" OnContent="" OffContent="" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Classes="sectionTitle" Text="{x:Static strings:AppStrings.Files}" />
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static strings:AppStrings.SdrFormat}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static strings:AppStrings.SdrFormatCaption}" />
                    </StackPanel>
                    <ComboBox x:Name="SdrFormatBox" Grid.Column="1" Width="150" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static strings:AppStrings.HdrFormat}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static strings:AppStrings.HdrFormatCaption}" />
                    </StackPanel>
                    <ComboBox x:Name="HdrFormatBox" Grid.Column="1" Width="150" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static strings:AppStrings.Quality}" />
                        <TextBlock Classes="caption" Text="{x:Static strings:AppStrings.QualityCaption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Slider x:Name="QualitySlider" Width="114" Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock x:Name="QualityText" Width="28" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static strings:AppStrings.SdrVersion}" />
                        <TextBlock x:Name="ToneMappingInfo" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ToneMappingBox" Grid.Column="1" Width="150" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border x:Name="ToneCurveRow" Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static strings:AppStrings.ToneCurve}" />
                        <TextBlock x:Name="ToneCurveInfo" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ToneCurveBox" Grid.Column="1" Width="150" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Classes="sectionTitle" Text="{x:Static strings:AppStrings.Appearance}" />
            <Border Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Static strings:AppStrings.Theme}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="150" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border x:Name="MicaRow" Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static strings:AppStrings.Mica}" />
                        <TextBlock Classes="caption" Text="{x:Static strings:AppStrings.MicaCaption}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MicaSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
            </Border>

            <TextBlock x:Name="StartupSectionTitle" Classes="sectionTitle" Text="{x:Static strings:AppStrings.Startup}" />
            <Border x:Name="StartupRow" Classes="settingRow">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static strings:AppStrings.StartWindows}" />
                        <TextBlock Classes="caption" Text="{x:Static strings:AppStrings.StartupCaption}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
            </Border>

            <TextBlock x:Name="AboutText" Classes="caption" Margin="2,20,2,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="using:WSnip.App.Editor"
        xmlns:capture="using:WSnip.App.Capture"
        xmlns:rendering="using:WSnip.App.Rendering"
        xmlns:controls="using:LightStudio.LightPlayer.Controls"
        xmlns:strings="using:WSnip.Core.Strings"
        x:Class="WSnip.App.Editor.EditorWindow"
        Title="WSnip"
        Width="1120" Height="740" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppShellBackgroundBrush}"
        Icon="avares://WSnip.App/Assets/wsnip.ico">
    <Window.Styles>
        <StyleInclude Source="avares://WSnip.App/Themes/EditorDock.axaml" />
        <!-- Keep the native dropdown behavior and menu templates, with an icon-only face. -->
        <Style Selector="ComboBox.captureOption">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.captureOption /template/ ContentControl#ContentPresenter">
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style Selector="ComboBox.captureOption /template/ PathIcon#DropDownGlyph">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ComboBox.captureOption /template/ Border#Background">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="ComboBox.captureOption:focus-visible /template/ Border#HighlightBackground">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ComboBox.captureOption:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource AppSubtleHoverBrush}" />
        </Style>
        <Style Selector="ComboBox.captureOption:pressed /template/ Border#Background, ComboBox.captureOption:dropdownopen /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource AppSubtlePressedBrush}" />
        </Style>
        <Style Selector="ComboBox.captureOption:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource AppToolbarSurfaceBrush}"
                BorderBrush="{DynamicResource AppChromeDividerBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="NewButton" Classes="accent" Width="36" Height="36" Padding="8"
                            ToolTip.Tip="{x:Static strings:AppStrings.NewSnipTip}" AutomationProperties.Name="{x:Static strings:AppStrings.NewSnip}">
                        <Viewbox Width="18" Height="18">
                            <Path Data="{StaticResource IconAdd}" />
                        </Viewbox>
                    </Button>
                    <ComboBox x:Name="ModeBox" Classes="captureOption" VerticalAlignment="Center" ToolTip.Tip="{x:Static strings:AppStrings.SnippingMode}"
                              AutomationProperties.Name="{x:Static strings:AppStrings.SnippingMode}">
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="capture:SnipModeOption">
                                <Viewbox Width="20" Height="20">
                                    <Path Data="{Binding Icon}" Fill="{DynamicResource AppPrimaryTextBrush}" />
                                </Viewbox>
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="capture:SnipModeOption">
                                <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding Description}">
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="{Binding Icon}" Fill="{DynamicResource AppPrimaryTextBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource AppPrimaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="DelayBox" Classes="captureOption" VerticalAlignment="Center" ToolTip.Tip="{x:Static strings:AppStrings.DelayTip}"
                              AutomationProperties.Name="{x:Static strings:AppStrings.Delay}">
                        <ComboBox.SelectionBoxItemTemplate>
                            <DataTemplate x:DataType="capture:DelayOption">
                                <Panel Width="28" Height="26">
                                    <Viewbox Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Path Data="{StaticResource IconClock}" Fill="{DynamicResource AppPrimaryTextBrush}" />
                                    </Viewbox>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="3" Padding="2,1"
                                            Background="{DynamicResource AppPrimaryTextBrush}">
                                        <Panel>
                                            <Viewbox Width="10" Height="10" IsVisible="{Binding !HasDelay}">
                                                <Path Data="{StaticResource IconDisabled}" Fill="{DynamicResource AppPanelBackgroundBrush}" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding BadgeText}" IsVisible="{Binding HasDelay}" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppPanelBackgroundBrush}" />
                                        </Panel>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                        </ComboBox.SelectionBoxItemTemplate>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="capture:DelayOption">
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource AppPrimaryTextBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="CopyButton" Classes="icon" ToolTip.Tip="{x:Static strings:AppStrings.CopyTip}" AutomationProperties.Name="{x:Static strings:AppStrings.Copy}">
                        <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconCopy}" /></Viewbox>
                    </Button>
                    <Button x:Name="SaveButton" Classes="icon" ToolTip.Tip="{x:Static strings:AppStrings.SaveAsTip}" AutomationProperties.Name="{x:Static strings:AppStrings.SaveAs}">
                        <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconSave}" /></Viewbox>
                    </Button>
                    <Button x:Name="MoreButton" Classes="icon" ToolTip.Tip="{x:Static strings:AppStrings.More}" AutomationProperties.Name="{x:Static strings:AppStrings.More}">
                        <Viewbox Width="18" Height="18"><Path Data="{StaticResource IconMore}" /></Viewbox>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem x:Name="OpenFolderItem" Header="{x:Static strings:AppStrings.OpenFolder}" />
                                <MenuItem x:Name="SettingsItem" Header="{x:Static strings:AppStrings.Settings}" />
                                <Separator />
                                <MenuItem x:Name="ExitItem" Header="{x:Static strings:AppStrings.ExitWSnip}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The snip -->
        <Border Grid.Row="1" Background="{DynamicResource AppCanvasBackgroundBrush}">
            <Panel>
                <editor:SnipCanvas x:Name="Canvas" />
                <Canvas x:Name="PixelInfoLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="PixelInfo" Classes="pixelInfo" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*">
                            <rendering:ColorSwatch x:Name="PixelSwatch" Width="28" Height="28" VerticalAlignment="Top" Margin="0,2,8,0" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock x:Name="PixelPosition" FontWeight="SemiBold" />
                                <TextBlock x:Name="PixelColor" />
                                <TextBlock x:Name="PixelLinear" Classes="caption" />
                                <TextBlock x:Name="PixelLuminance" Classes="caption" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Canvas>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460">
                    <Viewbox Width="52" Height="52" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconScissors}" Fill="{DynamicResource AppAccentBrush}" />
                    </Viewbox>
                    <TextBlock Text="{x:Static strings:AppStrings.TakeSnip}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AppPrimaryTextBrush}" />
                    <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource AppSecondaryTextBrush}" />
                </StackPanel>
                <Border x:Name="EditorDock" Classes="editorDock" IsVisible="False" MaxWidth="640"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,16">
                    <controls:BackdropBorder CornerRadius="7" Padding="6" BackdropStyle="Blur"
                                             FallbackColor="#E6222222" TintColor="#50000000">
                        <StackPanel Spacing="6">
                            <Border x:Name="ToolOptions" Classes="dockOptions" IsVisible="False">
                                <WrapPanel HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,4,0">
                                        <ScrollViewer MaxWidth="280" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" />
                                        </ScrollViewer>
                                        <Button x:Name="AddColorButton" VerticalAlignment="Center"
                                                ToolTip.Tip="{x:Static strings:AppStrings.AddColor}" AutomationProperties.Name="{x:Static strings:AppStrings.AddColor}">
                                            <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconAdd}" /></Viewbox>
                                        </Button>
                                        <ToggleButton x:Name="PickColorTool" VerticalAlignment="Center"
                                                      ToolTip.Tip="{x:Static strings:AppStrings.PickColorTip}" AutomationProperties.Name="{x:Static strings:AppStrings.PickColor}">
                                            <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconEyedropper}" /></Viewbox>
                                        </ToggleButton>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                                        <Border Classes="dockDivider" />
                                        <TextBlock Text="{x:Static strings:AppStrings.Size}" VerticalAlignment="Center" FontSize="12" />
                                        <Slider x:Name="SizeSlider" Width="128" Height="36" Minimum="1" Maximum="40" VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Static strings:AppStrings.Size}">
                                            <Slider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackFill" Color="#80FFFFFF" />
                                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#A0FFFFFF" />
                                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#A0FFFFFF" />
                                                <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#40FFFFFF" />
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="White" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D8FFFFFF" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#60FFFFFF" />
                                                <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
                                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
                                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#D8FFFFFF" />
                                                <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#60FFFFFF" />
                                            </Slider.Resources>
                                        </Slider>
                                    </StackPanel>
                                </WrapPanel>
                            </Border>
                            <Border x:Name="CropBar" Classes="dockOptions" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CropSize" VerticalAlignment="Center" Margin="10,0" />
                                    <Button x:Name="ApplyCropButton" Classes="dockText dockPrimary" Content="{x:Static strings:AppStrings.Apply}" />
                                    <Button x:Name="CancelCropButton" Classes="dockText" Content="{x:Static strings:AppStrings.Cancel}" />
                                </StackPanel>
                            </Border>
                            <WrapPanel HorizontalAlignment="Center">
                                <StackPanel x:Name="MarkupBar" Orientation="Horizontal" Spacing="2">
                                    <ToggleButton x:Name="PenTool" ToolTip.Tip="{x:Static strings:AppStrings.Pen}" AutomationProperties.Name="{x:Static strings:AppStrings.Pen}">
                                        <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconPen}" /></Viewbox>
                                    </ToggleButton>
                                    <ToggleButton x:Name="HighlighterTool" ToolTip.Tip="{x:Static strings:AppStrings.Highlighter}" AutomationProperties.Name="{x:Static strings:AppStrings.Highlighter}">
                                        <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconHighlighter}" /></Viewbox>
                                    </ToggleButton>
                                    <ToggleButton x:Name="EraserTool" ToolTip.Tip="{x:Static strings:AppStrings.Eraser}" AutomationProperties.Name="{x:Static strings:AppStrings.Eraser}">
                                        <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconEraser}" /></Viewbox>
                                    </ToggleButton>
                                    <ToggleButton x:Name="CropTool" ToolTip.Tip="{x:Static strings:AppStrings.Crop}" AutomationProperties.Name="{x:Static strings:AppStrings.Crop}">
                                        <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconCrop}" /></Viewbox>
                                    </ToggleButton>
                                    <Border Classes="dockDivider" />
                                    <Button x:Name="UndoButton" ToolTip.Tip="{x:Static strings:AppStrings.UndoTip}" AutomationProperties.Name="{x:Static strings:AppStrings.Undo}">
                                        <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconUndo}" /></Viewbox>
                                    </Button>
                                    <Button x:Name="RedoButton" ToolTip.Tip="{x:Static strings:AppStrings.RedoTip}" AutomationProperties.Name="{x:Static strings:AppStrings.Redo}">
                                        <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconRedo}" /></Viewbox>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="HdrBar" Orientation="Horizontal" Spacing="2" IsVisible="False">
                                    <Border Classes="dockDivider" />
                                    <Button x:Name="ToneMappingButton" ToolTip.Tip="{x:Static strings:AppStrings.ToneMappingTip}" AutomationProperties.Name="{x:Static strings:AppStrings.ToneMapping}">
                                        <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconTune}" /></Viewbox>
                                    </Button>
                                    <ToggleButton x:Name="HdrToggle" Width="40" Padding="6" IsChecked="True" ToolTip.Tip="{x:Static strings:AppStrings.ShowHdr}" AutomationProperties.Name="{x:Static strings:AppStrings.ShowHdr}">
                                        <Viewbox Width="27" Height="18"><Path x:Name="HdrIcon" Data="{StaticResource IconHdrOn}" /></Viewbox>
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Border Classes="dockDivider" />
                                    <Button x:Name="ZoomOutButton" ToolTip.Tip="{x:Static strings:AppStrings.ZoomOutTip}" AutomationProperties.Name="{x:Static strings:AppStrings.ZoomOut}">
                                        <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconZoomOut}" /></Viewbox>
                                    </Button>
                                    <Button x:Name="ZoomButton" Width="64" ToolTip.Tip="{x:Static strings:AppStrings.ZoomFitTip}" AutomationProperties.Name="{x:Static strings:AppStrings.ZoomFitTip}">
                                        <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12" />
                                    </Button>
                                    <Button x:Name="ZoomInButton" ToolTip.Tip="{x:Static strings:AppStrings.ZoomInTip}" AutomationProperties.Name="{x:Static strings:AppStrings.ZoomIn}">
                                        <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconZoomIn}" /></Viewbox>
                                    </Button>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </controls:BackdropBorder>
                </Border>
            </Panel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="2" Padding="12,4" Background="{DynamicResource AppToolbarSurfaceBrush}"
                BorderBrush="{DynamicResource AppChromeDividerBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="SavedLink" Grid.Column="1" Classes="flat" Padding="6,2" IsVisible="False" ToolTip.Tip="{x:Static strings:AppStrings.ShowInFolder}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconFolder}" Fill="{DynamicResource AppSecondaryTextBrush}" /></Viewbox>
                        <TextBlock x:Name="SavedText" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="using:WSnip.App.Rendering"
             xmlns:strings="using:WSnip.Core.Strings"
             x:Class="WSnip.App.Editor.ColorEditor"
             Width="320">
    <UserControl.Resources>
        <!-- Fluent reserves tick bar room above and below the thumb; these sliders have no ticks. -->
        <GridLength x:Key="SliderPreContentMargin">6</GridLength>
        <GridLength x:Key="SliderPostContentMargin">6</GridLength>
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <rendering:ColorSwatch x:Name="Preview" Width="48" Height="48" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryTextBrush}" />
                <TextBlock x:Name="SummaryText" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,*,36" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
            <TextBlock x:Name="GamutLabel" Text="{x:Static strings:AppStrings.ColorSpace}" VerticalAlignment="Center" Classes="caption" />
            <ComboBox x:Name="GamutBox" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="1" Text="{x:Static strings:AppStrings.Hex}" VerticalAlignment="Center" Classes="caption" />
            <TextBox x:Name="HexBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" MaxLength="7" />

            <TextBlock Grid.Row="2" Text="{x:Static strings:AppStrings.Red}" VerticalAlignment="Center" Classes="caption" />
            <Slider x:Name="RedSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" />
            <TextBlock x:Name="RedText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="caption" />

            <TextBlock Grid.Row="3" Text="{x:Static strings:AppStrings.Green}" VerticalAlignment="Center" Classes="caption" />
            <Slider x:Name="GreenSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" />
            <TextBlock x:Name="GreenText" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="caption" />

            <TextBlock Grid.Row="4" Text="{x:Static strings:AppStrings.Blue}" VerticalAlignment="Center" Classes="caption" />
            <Slider x:Name="BlueSlider" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255" />
            <TextBlock x:Name="BlueText" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="caption" />

            <TextBlock x:Name="BrightnessLabel" Grid.Row="5" Text="{x:Static strings:AppStrings.Brightness}" VerticalAlignment="Center" Classes="caption"
                       ToolTip.Tip="{x:Static strings:AppStrings.BrightnessTip}" />
            <Slider x:Name="BrightnessSlider" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="4" SmallChange="0.1" LargeChange="1" />
            <TextBlock x:Name="BrightnessText" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="caption" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Classes="flat" MinWidth="88" HorizontalContentAlignment="Center"
                    Content="{x:Static strings:AppStrings.Cancel}" />
            <Button x:Name="ApplyButton" Classes="accent" MinWidth="88" Content="{x:Static strings:AppStrings.Add}" />
        </StackPanel>
    </StackPanel>
</UserControl>

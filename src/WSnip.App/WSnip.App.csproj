<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cross-platform user interface: the capture overlay, the editor, settings and the tray. Platform
    features come in through WSnip.Core.Platform, supplied by the application head.
  -->
  <PropertyGroup>
    <RootNamespace>WSnip.App</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WSnip.Core\WSnip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Compile Include="$(LightPlayerRoot)src\LightStudio.LightPlayer\Controls\Glide.cs" Link="Shared\Glide.cs" />
  </ItemGroup>
</Project>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WSnip.App.App"
             RequestedThemeVariant="Default"
             Name="WSnip">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://WSnip.App/Themes/Palette.axaml" />
                <ResourceInclude Source="avares://WSnip.App/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://WSnip.App/Themes/Styles.axaml" />
    </Application.Styles>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Platform-neutral core: capture models, platform service contracts, HDR image processing
    (analysis, SDR rendition, gain maps) and the still-image encoders. FFmpeg bindings are
    generated by LightStudio.FfmpegShim for the selected native runtime.
  -->
  <PropertyGroup>
    <RootNamespace>WSnip.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Strings\AppStrings.resx">
      <StronglyTypedLanguage>C#</StronglyTypedLanguage>
      <StronglyTypedNamespace>WSnip.Core.Strings</StronglyTypedNamespace>
      <StronglyTypedClassName>AppStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)AppStrings.g.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(LightPlayerRoot)src\LightStudio.Logging\LightStudio.Logging.csproj" />
    <ProjectReference Include="$(LightPlayerRoot)src\LightStudio.FfmpegShim\LightStudio.FfmpegShim.csproj" />
  </ItemGroup>
</Project>
